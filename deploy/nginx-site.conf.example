# partout.pro — Option A static-site server config (TEMPLATE for po-boss).
# This file is documentation, not live config: production nginx is only
# changed by po-boss after explicit operator approval of the routing plan.
# Security header matrix per po-security handoffs cee9848a + cf0d322b.
#
# ASSUMPTIONS: hugo build (public/) at /srv/partout/site/, flutter web build
# at /srv/partout/app/, existing API proxy to frps :8000 preserved verbatim.
#
# ── THE INHERITANCE TRAP (po-security cf0d322b HIGH) ──────────────────────
# nginx add_header is level-scoped: a location that declares ANY add_header
# silently drops every header inherited from above. Every block below that
# adds a header therefore includes a snippet that re-declares the FULL common
# matrix at its own level, then appends its surface-specific headers. If you
# add a new location that does add_header, include the snippets there too —
# deploy_check.sh asserts the matrix per path to catch drift.
#
# Install step (po-boss, after operator approval): copy the two REAL snippet
# files from this repo to the droplet and deploy the server block:
#   install -m 644 deploy/snippets/partout-common-security.conf \
#                  deploy/snippets/partout-app-security.conf /etc/nginx/snippets/
#   nginx -t && systemctl reload nginx
# scripts/check_deploy_template.py (run by CI) verifies every include here
# resolves under deploy/snippets/ and every add_header block includes the
# common matrix; a copy of it also runs `nginx -t` against this file.

server {
  listen 443 ssl;
  http2 on;
  server_name partout.pro;
  # ssl_certificate ... (keep existing droplet cert config)

  # Baseline for locations that add nothing (e.g. the API proxy, which sets
  # no add_header and therefore inherits this whole set):
  include snippets/partout-common-security.conf;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  # --- API paths first: the site must never shadow them (SPEC 16.1) --------
  location /api/     { proxy_pass http://127.0.0.1:8000; }  # existing frps proxy settings
  location /health   { proxy_pass http://127.0.0.1:8000; }
  location /uploads/ { proxy_pass http://127.0.0.1:8000; }

  # --- Flutter web (P3) ------------------------------------------------------
  # note: NO "location = /app/" block — exact match would shadow the prefix
  # block below and lose its alias; the prefix block handles the directory.
  location = /app      { include snippets/partout-common-security.conf; return 308 /app/; }
  location /app/ {
    alias /srv/partout/app/;
    # full matrix re-declared at this level (inheritance trap):
    include snippets/partout-common-security.conf;
    include snippets/partout-app-security.conf;
    add_header Cache-Control "no-store" always;   # documents + unversioned files

    # index + bootstrap must never cache (the service worker version query
    # lives INSIDE flutter_bootstrap.js — it is the invalidation point):
    location ~* ^/app/(index\.html|flutter_bootstrap\.js)$ {
      include snippets/partout-common-security.conf;
      include snippets/partout-app-security.conf;
      add_header Cache-Control "no-store" always;
    }
    # long cache for the versioned entry script (flutter pins it by query):
    location = /app/main.dart.js {
      include snippets/partout-common-security.conf;
      include snippets/partout-app-security.conf;
      add_header Cache-Control "public, max-age=604800" always;
      add_header Cross-Origin-Resource-Policy "same-origin" always;
    }
    # immutable ONLY for content-versioned paths (canvaskit dir carries the
    # engine version; fonts/icons are build-stable):
    location ~* ^/app/(canvaskit/|assets/fonts/|icons/) {
      include snippets/partout-common-security.conf;
      include snippets/partout-app-security.conf;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      add_header Cross-Origin-Resource-Policy "same-origin" always;
    }
  }

  # --- legacy admin: proxied to the backend until P4 parity sign-off -------
  # noindex + no-store from day one (cf0d322b MED-2). 55b115bd MED-2: the
  # legacy admin.html/login.html use inline script/style and onclick
  # handlers, so they get a tailored CSP with 'unsafe-inline' — a CSP-less
  # high-value console is not acceptable; the strict no-inline policy
  # arrives with the P4 Flutter console (frame-ancestors/object-src hold now).
  location = /admin {
    include snippets/partout-common-security.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    proxy_pass http://127.0.0.1:8000;
  }
  location = /admin/ {
    include snippets/partout-common-security.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    return 308 /admin;
  }

  # --- Hugo site ------------------------------------------------------------
  location / {
    root /srv/partout/site;
    try_files $uri $uri/ $uri/index.html =404;
    error_page 404 /404.html;    # branded 404 shipped by hugo
    include snippets/partout-common-security.conf;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /robots.txt {
      include snippets/partout-common-security.conf;
      add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
    location ~* \.(css|js|png|jpg|jpeg|svg|woff2?)$ {
      include snippets/partout-common-security.conf;
      add_header Cache-Control "public, max-age=3600" always;
      add_header Cross-Origin-Resource-Policy "same-origin" always;
    }
  }
}

server {
  listen 80;
  server_name partout.pro;
  return 301 https://$host$request_uri;
}
